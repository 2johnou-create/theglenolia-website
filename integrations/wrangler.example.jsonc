{
  "name": "glenolia-newsletter",
  "main": "newsletter-worker.mjs",
  "compatibility_date": "2026-10-12",
  "vars": {
    "ALLOWED_ORIGINS": "https://theglenolia.com.au",
    "BREVO_LIST_ID": "",
    "BREVO_TEMPLATE_EN": "",
    "BREVO_TEMPLATE_ZH": "",
    "BREVO_TEMPLATE_JA": ""
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 30, "period": 60}
    },
    {
      "name": "RECIPIENT_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 5, "period": 60}
    }
  ]
}
